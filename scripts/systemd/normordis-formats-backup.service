[Unit]
Description=NORMORDIS formats local and Google Drive backup
Documentation=file:/srv/normordis/repos/normordis-formats/README.md

[Service]
Type=oneshot
WorkingDirectory=/srv/normordis/repos/normordis-formats
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
ExecStartPre=/usr/bin/mountpoint -q /mnt/normordis-backup
ExecStartPre=/usr/bin/test -d /mnt/normordis-backup/backups/repos/normordis-formats
ExecStart=/usr/bin/bash /srv/normordis/repos/normordis-formats/scripts/bash/backup/full-repo-backup.sh --keep-last 5
ExecStart=/usr/bin/bash /srv/normordis/repos/normordis-formats/scripts/bash/backup/sync-google-drive.sh --keep-last 5
StandardOutput=append:/srv/normordis/logs/backups/normordis-formats-backup.log
StandardError=append:/srv/normordis/logs/backups/normordis-formats-backup.log
