{
  "_comment": "Lista ordenada com um item que contém uma lista não-ordenada aninhada. Valida o modelo list_item com inlines + lista nested em content.",
  "ncrtf_version": "2.0.0",
  "content": [
    {
      "type": "list",
      "list_type": "ordered",
      "content": [
        {
          "type": "list_item",
          "content": [
            { "type": "text", "text": "Primeiro item simples." }
          ]
        },
        {
          "type": "list_item",
          "content": [
            { "type": "text", "text": "Segundo item com sub-lista:" },
            {
              "type": "list",
              "list_type": "bullet",
              "content": [
                {
                  "type": "list_item",
                  "content": [ { "type": "text", "text": "Sub-item A." } ]
                },
                {
                  "type": "list_item",
                  "content": [ { "type": "text", "text": "Sub-item B." } ]
                }
              ]
            }
          ]
        },
        {
          "type": "list_item",
          "content": [
            { "type": "text", "text": "Terceiro item simples." }
          ]
        }
      ]
    }
  ]
}
